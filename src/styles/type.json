{
  "font": {
    "sans": "'Inter Variable', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
  },
  "roles": {
    "display": {
      "size": "clamp(1.875rem, 4vw, 2.75rem)",
      "line": "1.08",
      "weight": "600",
      "tracking": "-0.02em",
      "use": "The one big headline on a page."
    },
    "title": {
      "size": "1.375rem",
      "line": "1.75rem",
      "weight": "600",
      "tracking": "-0.01em",
      "use": "Section headings and panel titles."
    },
    "body": {
      "size": "1rem",
      "line": "1.5rem",
      "weight": "400",
      "tracking": "0",
      "use": "Running text."
    },
    "caption": {
      "size": "0.875rem",
      "line": "1.25rem",
      "weight": "400",
      "tracking": "0",
      "use": "Labels, captions, table cells, notes."
    },
    "mono": {
      "size": "0.8125rem",
      "line": "1.25rem",
      "weight": "400",
      "tracking": "0",
      "use": "Values: hex codes, tokens, numbers, code."
    }
  }
}
