{
  "name": "@nurvus/ui",
  "version": "0.1.0-alpha.1",
  "description": "NURVUS Design System",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && npm run build:tokens && webpack --mode=production --json > stats.json",
    "build:tokens": "node ./tools/build-tokens.js",
    "prepare": "npm run build",
    "styleguide": "npm run docs",
    "styleguide:build": "npm run docs:build",
    "docs": "npm run build:tokens && vite --config docs/vite.config.js",
    "docs:build": "npm run build:tokens && vite build --config docs/vite.config.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@material-ui/core": "^4.12.3",
    "@material-ui/icons": "^4.11.2",
    "classnames": "^2.3.1",
    "clsx": "^1.2.1",
    "lodash": "^4.17.20",
    "prop-types": "^15.7.2"
  },
  "peerDependencies": {
    "react": "^16.8.0",
    "react-dom": "^16.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.12.3",
    "@babel/plugin-proposal-class-properties": "^7.14.5",
    "@babel/preset-env": "^7.12.1",
    "@babel/preset-react": "^7.12.1",
    "@babel/preset-typescript": "^7.29.7",
    "@codemirror/commands": "^6.11.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-loader": "^8.1.0",
    "cross-env": "^7.0.3",
    "css-loader": "^5.0.0",
    "file-loader": "^6.2.0",
    "marked": "^18.3.0",
    "postcss": "^8.4.14",
    "react": "^16.8.0",
    "react-docgen": "^8.0.4",
    "react-dom": "^16.8.0",
    "resolve-url-loader": "^5.0.0",
    "rimraf": "^3.0.2",
    "sass": "^1.77.8",
    "sass-loader": "^10.0.4",
    "style-loader": "^2.0.0",
    "sucrase": "^3.35.1",
    "typescript": "^4.4.3",
    "vite": "^8.3.8",
    "webpack": "^5.113.0",
    "webpack-cli": "^5.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwehhh/nurvus-design-system.git"
  },
  "keywords": [],
